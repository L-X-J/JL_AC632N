<view class="page-shell">
  <view class="topbar">
    <view>
      <text class="eyebrow">ICXL / RIDER</text>
      <text class="title">CoreTemp 调试台</text>
    </view>
    <view class="status-dot {{connected ? 'online' : ''}}"></view>
  </view>

  <view class="toolbar">
    <button class="primary" bindtap="scan" loading="{{status === 'scanning'}}">扫描设备</button>
    <button class="secondary" bindtap="disconnect" disabled="{{!connected}}">断开</button>
    <button class="secondary" bindtap="toggleCollect" disabled="{{!connected}}">{{collecting ? '暂停记录' : '开始记录'}}</button>
  </view>

  <view wx:if="{{error}}" class="notice error">{{error}}</view>

  <view class="section-heading"><text>设备</text><text class="muted">{{statusText}}</text></view>
  <scroll-view class="device-list" scroll-y wx:if="{{devices.length}}">
    <view class="device-row" wx:for="{{devices}}" wx:key="deviceId" data-index="{{index}}" bindtap="connect">
      <view>
        <text class="device-name">{{item.displayName}}</text>
        <text class="device-id">{{item.deviceId}}</text>
      </view>
      <text class="row-action">连接</text>
    </view>
  </scroll-view>
  <view wx:else class="empty">扫描后会显示广播名包含 RTemp 的设备</view>

  <view class="section-heading"><text>实时快照</text><text class="muted">{{shownRecordCount}} 条记录</text></view>
  <view class="metrics" wx:if="{{latest}}">
    <view class="metric primary-metric"><text class="metric-label">发布核心</text><text class="metric-value">{{latest.publishedCoreLabel}}</text><text class="metric-note">候选 {{latest.coreCandidateLabel}}</text></view>
    <view class="metric"><text class="metric-label">皮温</text><text class="metric-value">{{latest.skinLabel}}</text><text class="metric-note">传感器 {{latest.sensorLabel}}</text></view>
    <view class="metric"><text class="metric-label">接触</text><text class="metric-value">{{latest.contactLabel}}</text><text class="metric-note">{{latest.temperatureStateLabel}}</text></view>
    <view class="metric"><text class="metric-label">质量</text><text class="metric-value">{{latest.qualityLabel}}</text><text class="metric-note">置信度 {{latest.confidence}}%</text></view>
  </view>
  <view wx:else class="empty">连接并订阅 2111 后，固件会每 200 ms 发送最新 1 秒快照</view>

  <view class="detail-grid" wx:if="{{latest}}">
    <view class="detail-line"><text>序号</text><text>{{latest.sequence}}</text></view>
    <view class="detail-line"><text>核心状态</text><text>{{latest.coreStateLabel}} / {{latest.coreHistorySeconds}} s</text></view>
    <view class="detail-line"><text>接触样本</text><text>{{latest.contactSamples}} / 典型 {{latest.typicalSamples}}</text></view>
    <view class="detail-line"><text>心率</text><text>{{latest.heartRate || '--'}} {{latest.heartRateUsed ? '已用于模型' : ''}}</text></view>
    <view class="detail-line"><text>模型</text><text>v{{latest.modelVersion}} / {{latest.modelMode}}</text></view>
    <view class="detail-line"><text>原始帧</text><text class="mono">{{rawHex}}</text></view>
  </view>

  <view class="section-heading"><text>记录</text><text class="muted">最多保留 5000 条</text></view>
  <view class="record-actions">
    <button class="secondary" bindtap="exportCsv" disabled="{{!records.length}}">导出 CSV</button>
    <button class="secondary" bindtap="clearRecords" disabled="{{!records.length}}">清空</button>
  </view>
  <scroll-view class="record-list" scroll-y wx:if="{{records.length}}">
    <view class="record-row" wx:for="{{records}}" wx:key="receivedAt">
      <text class="record-seq">#{{item.sequence}}</text>
      <text>{{item.publishedCoreLabel}}</text>
      <text>{{item.skinLabel}}</text>
      <text class="record-state">{{item.coreStateLabel}}</text>
    </view>
  </scroll-view>

  <view class="section-heading"><text>固件升级</text><text class="muted">RCSP / 实验</text></view>
  <view class="ota-row"><text class="ota-copy">{{otaText}}</text><button class="secondary" bindtap="probeOta" disabled="{{!connected}}">检查通道</button></view>
  <button class="ota-button" bindtap="chooseFirmware" disabled="{{!otaAvailable}}">选择固件文件</button>
  <view class="ota-warning">当前 Rider 板级配置 CONFIG_APP_OTA_ENABLE=0。小程序保留 AE00/AE01/AE02 探测和分包适配，但不会在未认证的固件上发送升级数据。</view>
</view>

.page-shell { padding: 32rpx 30rpx 60rpx; }
.topbar { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 28rpx; }
.eyebrow { display: block; color: #6f7c84; font-size: 20rpx; letter-spacing: 2rpx; }
.title { display: block; margin-top: 6rpx; color: #11181d; font-size: 42rpx; font-weight: 700; }
.status-dot { width: 18rpx; height: 18rpx; margin-top: 12rpx; border-radius: 50%; background: #aeb8bd; }
.status-dot.online { background: #26a269; box-shadow: 0 0 0 8rpx rgba(38,162,105,.12); }
.toolbar, .record-actions, .ota-row { display: flex; gap: 16rpx; align-items: center; }
button { margin: 0; border-radius: 6rpx; font-size: 25rpx; line-height: 76rpx; }
.primary { flex: 1; color: white; background: #0d6e8a; }
.secondary { color: #26343b; background: #e4e9ec; }
.toolbar .secondary { min-width: 150rpx; }
.notice { margin-top: 20rpx; padding: 18rpx 20rpx; border-left: 6rpx solid #c34c4c; color: #8b2f35; background: #fbeeee; font-size: 24rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: baseline; margin: 42rpx 0 14rpx; font-size: 28rpx; font-weight: 700; }
.muted { color: #7c898f; font-size: 22rpx; font-weight: 400; }
.device-list, .record-list { max-height: 300rpx; background: white; border-top: 1rpx solid #dfe5e8; border-bottom: 1rpx solid #dfe5e8; }
.device-row, .record-row { display: flex; align-items: center; justify-content: space-between; min-height: 86rpx; padding: 0 20rpx; border-bottom: 1rpx solid #edf0f1; }
.device-name { display: block; font-size: 28rpx; font-weight: 600; }
.device-id { display: block; margin-top: 5rpx; color: #879299; font-size: 20rpx; }
.row-action { color: #0d6e8a; font-size: 24rpx; }
.empty { padding: 38rpx 22rpx; color: #89969c; background: #fff; text-align: center; font-size: 24rpx; }
.metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.metric { min-height: 150rpx; padding: 20rpx; background: #fff; border-top: 4rpx solid #dfe5e8; }
.primary-metric { border-top-color: #0d6e8a; }
.metric-label, .metric-note { display: block; color: #718087; font-size: 22rpx; }
.metric-value { display: block; margin: 12rpx 0 8rpx; color: #14252d; font-size: 34rpx; font-weight: 700; }
.metric-note { font-size: 21rpx; }
.detail-grid { margin-top: 16rpx; padding: 2rpx 20rpx; background: #fff; }
.detail-line { display: flex; justify-content: space-between; gap: 20rpx; min-height: 70rpx; padding: 18rpx 0; border-bottom: 1rpx solid #edf0f1; color: #647279; font-size: 23rpx; }
.detail-line text:last-child { max-width: 70%; color: #25343b; text-align: right; }
.mono { word-break: break-all; font-family: monospace; font-size: 19rpx !important; }
.record-actions button { flex: 1; }
.record-row { justify-content: flex-start; gap: 22rpx; color: #304149; font-size: 22rpx; }
.record-row text { min-width: 120rpx; }
.record-row .record-seq { min-width: 80rpx; color: #879299; }
.record-row .record-state { min-width: 120rpx; color: #0d6e8a; }
.ota-row { padding: 20rpx; background: #fff; }
.ota-copy { flex: 1; color: #57666d; font-size: 22rpx; line-height: 1.5; }
.ota-row button { flex: 0 0 190rpx; }
.ota-button { width: 100%; margin-top: 14rpx; color: #56656c; background: #dce3e6; }
.ota-warning { margin-top: 14rpx; color: #8b6d39; font-size: 21rpx; line-height: 1.5; }
